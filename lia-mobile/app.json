{
  "expo": {
    "name": "LIA",
    "slug": "lia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#6FA8DC",
    "assetBundlePatterns": [
      "assets/**/*",
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lia.medications",
      "infoPlist": {
        "NSCameraUsageDescription": "LÍA usa la cámara de tu celular para reconocer medicamentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6FA8DC"
      },
      "package": "com.lia.medications",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173B59",
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LÍA usa tu galería para cambiar tu foto de perfil.",
          "cameraPermission": "LÍA usa la cámara de tu celular para reconocer medicamentos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LÍA usa la cámara de tu celular para reconocer medicamentos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6FA8DC"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:3000/api"
    }
  }
}
