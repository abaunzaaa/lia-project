{
  "expo": {
    "name": "LIA",
    "slug": "lia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#6FA8DC",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#173B59"
    },
    "assetBundlePatterns": ["assets/**/*", "src/assets/**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lia.medications"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6FA8DC"
      },
      "package": "com.lia.medications",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LÍA usa tu galería para cambiar tu foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6FA8DC"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api"
    }
  }
}
